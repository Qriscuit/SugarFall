func board_peg_count(index):
	if index>=1 and index<=board_data.size(): return int(board_data[index-1].get("peg_count",24+mini(22,(index-1)*2)))
	return 24+mini(22,maxi(0,index-1)*2)

func board_name(index):
	if index >= 1 and index <= board_data.size():
		return str(board_data[index-1].get("name","Board %d" % index))
	return "Board %02d" % index

func draw_loadout():
	if trial_active: button(Rect2(36,22,100,96),"<")
	text_at("TRIAL LOADOUT" if trial_active else "YOUR LOADOUT",Vector2(160 if trial_active else 48,110),36 if trial_active else 42)
	text_at("%d / %d module slots equipped" % [equipped.size(),module_slots()],Vector2(48,165),27,TEAL)
	text_at(("Fixed core %.1f damage • fixed feeder • all modules free" % (1+levels[1]*tuning.core_step)) if trial_active else ("%d FREE UNLOCK • tap an unowned module" % module_vouchers if module_vouchers>0 else "Free lab unlocks: clear boards 2, 5 and 8."),Vector2(48,207),21,GOLD if module_vouchers>0 else MUTED)
	var names=["RICOCHET","SPLITTER","IMPACT"]
	var kinds=["ricochet","splitter","impact"]
	var descs=[["Retains more energy after peg collisions.","Try on separated targets and repeat hits."],["First contact creates three half-power shards.","Try on dense groups of fragile pegs."],["Crushes its first peg, regardless of its armor.","Aim its queued shot at a tough target."]]
	for i in range(3):
		var r=Rect2(48,260+i*220,624,190)
		var active=kinds[i] in equipped
		box(r,PANEL,18,TEAL if active else Color.TRANSPARENT)
		draw_circle(r.position+Vector2(43,45),15,ball_color(kinds[i]))
		text_at(names[i],r.position+Vector2(80,53),30)
		text_at("EQUIPPED" if active else ("TAP TO EQUIP" if levels[i+3]>0 else ("FREE UNLOCK" if module_vouchers>0 else "BUY / EARN")),r.position+Vector2(400,50),19,TEAL if active else MUTED)
		text_at(descs[i][0],r.position+Vector2(24,105),23,MUTED)
		text_at(descs[i][1],r.position+Vector2(24,140),23,MUTED)
	text_at("Choose any two. Campaign upgrades stay unchanged." if trial_active else "Free swaps. Second slot opens after board 3.",Vector2(48,990),23,TEAL)
	button(Rect2(48,1080,624,96),"START TRIAL" if trial_active else "BACK TO WORKSHOP",true)

