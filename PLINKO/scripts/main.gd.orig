func draw_shop():
	upgrade_map.draw()

func upgrade_preview(i):
	var now=levels[i]
	var next=mini(now+1,MAX_LEVELS[i])
	match i:
		0: return "%.2f → %.2f balls/s" % [(1+now*.18)/.74,(1+next*.18)/.74]
		1: return "%.1f → %.1f dmg · %d → %d hits" % [1+now*tuning.core_step,1+next*tuning.core_step,ceili(6.0/(1+now*tuning.core_step)),ceili(6.0/(1+next*tuning.core_step))]
		2: return "%.0f%% → %.0f%% bounce energy" % [(.73+now*.035)*100,(.73+next*.035)*100]
		6: return "Gold bin: %dx → %dx" % [3+now,3+next]
		7: return "Shift: %.1fs → %.1fs" % [BASE_SECONDS+now*CLOCK_STEP,BASE_SECONDS+next*CLOCK_STEP]
	var kind=["ricochet","splitter","impact"][i-3]
	var base=.06 if i==3 else .04
	var growth=.012 if i==3 else .008
	var state="EQUIPPED" if kind in equipped else ("UNEQUIPPED" if now>0 else "LOCKED")
	return "%.1f%% → %.1f%% • %s" % [(base+growth*now)*100 if now>0 else 0,(base+growth*next)*100,state]

func upgrade_value(i):
	match i:
		0: return "%.2f balls / sec" % ((1+levels[0]*.18)/.74)
		1: return "%.2f damage / hit" % (1+levels[1]*tuning.core_step)
		2: return "%.0f%% energy retained" % ((.73+levels[2]*.035)*100)
		3: return "%.1f%% chance • extra bounce" % ((.06+.012*levels[3])*100 if levels[3]>0 else 0)
		4: return "%.1f%% chance • 3 half-power shards" % ((.04+.008*levels[4])*100 if levels[4]>0 else 0)
		5: return "%.1f%% chance • first-hit crush" % ((.04+.008*levels[5])*100 if levels[5]>0 else 0)
		6: return "Gold bin base: %dx" % (3+levels[6])
		7: return "%.1f seconds per shift" % (BASE_SECONDS+levels[7]*CLOCK_STEP)
	return ""

