{
  "name": "sugarfall-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-sugarfall-commerce --config ../firebase.json --only firestore \"node --test test/firestore-rules.emulator.js\"",
    "check": "node --check src/index.js && node --check src/service.js && node --check src/firestore-store.js && node --check src/google-play.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "11.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0"
  }
}
