[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/startup.gd" id="1"]
[ext_resource type="Texture2D" path="res://data/art/branding/studio_stamp.png" id="2"]
[ext_resource type="Shader" path="res://data/art/branding/studio_stamp.gdshader" id="3"]
[ext_resource type="Shader" path="res://data/art/branding/studio_spotlight.gdshader" id="4"]
[ext_resource type="AudioStream" path="res://data/audio/studio_warm_hum.wav" id="5"]

[sub_resource type="ShaderMaterial" id="StampMaterial"]
resource_local_to_scene = true
shader = ExtResource("3")
shader_parameter/heartbeat = 0.0

[sub_resource type="ShaderMaterial" id="SpotlightMaterial"]
resource_local_to_scene = true
shader = ExtResource("4")
shader_parameter/heartbeat = 0.0

[node name="StudioStartup" type="Node"]
script = ExtResource("1")

[node name="Stage" type="CanvasLayer" parent="."]
layer = 100

[node name="Canvas" type="Control" parent="Stage"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="Stage/Canvas"]
material = SubResource("SpotlightMaterial")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1,1,1,1)

[node name="Stamp" type="TextureRect" parent="Stage/Canvas"]
material = SubResource("StampMaterial")
layout_mode = 0
mouse_filter = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="Failure" type="VBoxContainer" parent="Stage/Canvas"]
visible = false
layout_mode = 0
theme_override_constants/separation = 16

[node name="Message" type="Label" parent="Stage/Canvas/Failure"]
layout_mode = 2
text = "The game couldn't finish loading.\nYour progress hasn't been reset."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 25

[node name="Retry" type="Button" parent="Stage/Canvas/Failure"]
custom_minimum_size = Vector2(0,64)
layout_mode = 2
text = "Retry"

[node name="Quit" type="Button" parent="Stage/Canvas/Failure"]
custom_minimum_size = Vector2(0,64)
layout_mode = 2
text = "Close"

[node name="WarmHum" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5")
volume_db = -60.0
